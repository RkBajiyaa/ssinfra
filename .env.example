# ============================================================================
# SS Infratech: environment variables
# ============================================================================
# Real Firebase:  copy this file to .env.local (git-ignored) and fill it in,
#                 and add the same keys in Vercel → Project → Settings → Environment Variables.
# Emulators:      nothing to copy. `npm run dev:emulator` uses the committed .env.emulator.
#
# NEXT_PUBLIC_* values are compiled into the browser bundle and are public by design.
# Everything else is SERVER ONLY and secret. Never commit real values; this file holds placeholders only.
#
# Which Vercel environments:
#   Production   every REQUIRED key, with the live domain in NEXT_PUBLIC_SITE_URL.
#   Preview      same keys; you may reuse production values or point at a separate Firebase project.
#                Preview deployments write real leads to whichever project you configure.
#   Development  only used by `vercel dev` / `vercel env pull`; same keys as your .env.local.
#   NEVER set FIRESTORE_EMULATOR_HOST, FIREBASE_AUTH_EMULATOR_HOST or
#   NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST in Vercel: the build fails on purpose if you do.
#
# Changing any NEXT_PUBLIC_* value needs a rebuild/redeploy, because it is inlined at build time.
# ============================================================================


# ---------------------------------------------------------------------------
# Public site
# ---------------------------------------------------------------------------

# REQUIRED in Vercel. Canonical URLs, sitemap and Open Graph. Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# OPTIONAL (default false). Set to true only after confirming 096725 67423 is on WhatsApp.
NEXT_PUBLIC_WHATSAPP_ENABLED=false

# OPTIONAL. Shown on the site only when set. Leave empty until an official address is confirmed.
NEXT_PUBLIC_CONTACT_EMAIL=


# ---------------------------------------------------------------------------
# Firebase web app (browser). Used ONLY for admin sign-in; the browser never touches Firestore.
# Where: Firebase console → Project settings → General → Your apps → Web app → SDK setup (Config).
# ---------------------------------------------------------------------------

# REQUIRED for admin sign-in. Public identifier, not a secret.
NEXT_PUBLIC_FIREBASE_API_KEY=your-web-api-key
# REQUIRED for admin sign-in. Usually <project-id>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
# REQUIRED. THE project ID for browser AND server (Firebase Admin uses this same value).
# Where: Project settings → General → Project ID. Example shape: ss-infra-14cf8
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
# REQUIRED for admin sign-in.
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Not used: storageBucket, messagingSenderId, measurementId. The app has no file uploads,
# no Firebase Messaging and no Google Analytics, so Storage needs no configuration.


# ---------------------------------------------------------------------------
# Firebase Admin (server). SERVER ONLY, SECRET.
# The server authenticates with a service-account key (firebase-admin `cert()`).
# Application Default Credentials are NOT used: Vercel has no Google metadata server.
# Where: Firebase console → Project settings → Service accounts → Firebase Admin SDK →
#        Generate new private key. Copy two fields from the downloaded JSON, then delete the file.
# The key must come from the project in NEXT_PUBLIC_FIREBASE_PROJECT_ID (checked at startup).
# Without these two values the public site still works, but enquiries can't be saved and
# admin sign-in is off.
# ---------------------------------------------------------------------------

# REQUIRED for leads/admin. The JSON "client_email".
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# REQUIRED for leads/admin. The JSON "private_key", on ONE line with literal \n, in double quotes.
# In the Vercel dashboard paste the same value (quotes optional, both forms are accepted).
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_YOUR_KEY\n-----END PRIVATE KEY-----\n"

# FIREBASE_PROJECT_ID is no longer used. Delete it; if present it must equal
# NEXT_PUBLIC_FIREBASE_PROJECT_ID or Firebase is disabled with a config error.


# ---------------------------------------------------------------------------
# Analytics. SERVER ONLY, SECRET.
# ---------------------------------------------------------------------------

# REQUIRED in production (enquiries fail without it; dev uses a fixed fallback).
# Salts the anonymous visitor/rate-limit hashes. Generate: openssl rand -hex 32
ANALYTICS_SALT=replace-with-64-hex-characters


# ---------------------------------------------------------------------------
# Web push for the admin app. OPTIONAL: without all three, push is off and the
# leads badge still works. Generate a pair with: npx web-push generate-vapid-keys
# Use one pair per environment and keep it stable (changing it drops existing subscriptions).
# ---------------------------------------------------------------------------

NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
# SERVER ONLY, SECRET.
VAPID_PRIVATE_KEY=your-vapid-private-key
# https:// URL or mailto: of the site owner. Not localhost (Apple rejects it).
VAPID_SUBJECT=https://your-domain.example


# ---------------------------------------------------------------------------
# Emulators: LOCAL ONLY. These live in .env.emulator; don't add them here or to Vercel.
# All three must be set together, and setting any of them switches the server to emulator mode.
#   FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
#   FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
#   NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# ---------------------------------------------------------------------------

# Set automatically by Vercel (don't add): VERCEL. Used to refuse emulator settings there.
# CLI only, never stored in a file: ADMIN_PASSWORD lets scripts/create-admin.mjs run without a prompt (tests).
