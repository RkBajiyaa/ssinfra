# LOCAL EMULATOR PROFILE. Committed on purpose: it contains no secrets.
#
# Used by `npm run dev:emulator`, `npm run test:e2e` and
#   node --env-file=.env.emulator scripts/<name>.mjs
# These values are passed as real environment variables, so they take priority
# over .env.local; anything not set here (e.g. VAPID keys) still comes from .env.local.
#
# "demo-" project IDs exist only inside the emulators, so nothing here can ever
# reach a live Firebase project. Start the emulators with: npm run emulators
# Never copy these variables into Vercel: a Vercel build with emulator hosts fails on purpose.

NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-ssinfra
# The Auth emulator accepts any API key and app ID.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-ssinfra.firebaseapp.com
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id

FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Not a secret: only salts visitor hashes in the emulator database.
ANALYTICS_SALT=emulator-only-salt-not-secret
