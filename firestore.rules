rules_version = '2';

// All reads and writes go through the Next.js server using the Admin SDK,
// which bypasses these rules after doing its own authorisation checks.
// Browsers never talk to Firestore directly, so deny everything here:
// even a leaked web API key can't read leads or change packages.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
